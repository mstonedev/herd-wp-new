#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   herd-wp-new <site-name> [db-port]
#
# Examples:
#   herd-wp-new client-demo
#   herd-wp-new client-demo 3306
#   herd-wp-new maria-demo 3307

SITE_NAME="${1:-}"
DB_PORT="${2:-3306}"

if [[ -z "$SITE_NAME" ]]; then
  echo "Usage: herd-wp-new <site-name> [db-port]"
  exit 1
fi

# Laravel Herd project path and local domain.
HERD_DIR="$HOME/Herd"
SITE_PATH="$HERD_DIR/$SITE_NAME"
SITE_DOMAIN="${SITE_NAME}.test"
SITE_HTTP_URL="http://${SITE_DOMAIN}"
SITE_HTTPS_URL="https://${SITE_DOMAIN}"

# Database connection.
DB_HOST="127.0.0.1"
DB_NAME="$(echo "$SITE_NAME" | tr '-' '_' | tr -cd '[:alnum:]_')"
DB_USER="root"
DB_PASS=""

# Default WordPress administrator.
# Override these per command if needed:
# WP_ADMIN_USER=yourname WP_ADMIN_PASSWORD='strong-password' herd-wp-new example 3307
WP_TITLE="${SITE_NAME}"
WP_ADMIN_USER="${WP_ADMIN_USER:-admin}"
WP_ADMIN_PASSWORD="${WP_ADMIN_PASSWORD:-password}"
WP_ADMIN_EMAIL="${WP_ADMIN_EMAIL:-admin@${SITE_DOMAIN}}"

# Must-use local mail plugin.
LOCAL_MAIL_URL="https://github.com/mstonedev/local-mail-wp/releases/download/v1.0/local-mail.php"
MU_PLUGIN_DIR="$SITE_PATH/wp-content/mu-plugins"
LOCAL_MAIL_FILE="$MU_PLUGIN_DIR/local-mail.php"

# Do not overwrite an existing directory.
if [[ -e "$SITE_PATH" ]]; then
  echo "Error: directory already exists: $SITE_PATH"
  exit 1
fi

# Validate tools before making changes.
for command in wp mysql herd curl; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Error: '$command' is not installed or not available in PATH."
    exit 1
  fi
done

echo "Creating WordPress project: $SITE_NAME"
echo "Database server: ${DB_HOST}:${DB_PORT}"
echo

# Verify the selected database server is running at the requested TCP port.
mysql \
  --host="$DB_HOST" \
  --port="$DB_PORT" \
  --protocol=TCP \
  --user="$DB_USER" \
  -e "SELECT VERSION();" >/dev/null

# Create site and retrieve WordPress core.
mkdir -p "$SITE_PATH"
cd "$SITE_PATH"

echo "Downloading WordPress core..."
wp core download --quiet

echo "Creating wp-config.php..."
wp config create \
  --dbname="$DB_NAME" \
  --dbuser="$DB_USER" \
  --dbpass="$DB_PASS" \
  --dbhost="${DB_HOST}:${DB_PORT}" \
  --dbprefix="wp_" \
  --skip-check \
  --quiet

echo "Creating database: $DB_NAME"
wp db create --quiet

echo "Installing WordPress..."
wp core install \
  --url="$SITE_HTTP_URL" \
  --title="$WP_TITLE" \
  --admin_user="$WP_ADMIN_USER" \
  --admin_password="$WP_ADMIN_PASSWORD" \
  --admin_email="$WP_ADMIN_EMAIL" \
  --skip-email \
  --quiet

echo "Applying WordPress development settings..."
wp rewrite structure '/%postname%/' --hard --quiet

wp config set WP_DEBUG true --raw --quiet
wp config set WP_DEBUG_LOG true --raw --quiet
wp config set WP_DEBUG_DISPLAY true --raw --quiet

echo "Installing Query Monitor..."
wp plugin install query-monitor --activate --quiet

echo "Installing local-mail must-use plugin..."
mkdir -p "$MU_PLUGIN_DIR"

curl \
  --fail \
  --location \
  --silent \
  --show-error \
  "$LOCAL_MAIL_URL" \
  --output "$LOCAL_MAIL_FILE"

# Optional safety check: confirm it looks like a PHP plugin file.
if ! grep -q "Plugin Name:" "$LOCAL_MAIL_FILE"; then
  echo "Error: local-mail.php was downloaded but does not appear to be a WordPress plugin."
  rm -f "$LOCAL_MAIL_FILE"
  exit 1
fi

echo "Securing site with Herd..."
herd secure "$SITE_PATH" 2>/dev/null || herd secure

echo "Switching WordPress URLs to HTTPS..."
wp option update home "$SITE_HTTPS_URL" --quiet
wp option update siteurl "$SITE_HTTPS_URL" --quiet

echo
echo "WordPress site is ready."
echo
echo "URL:       $SITE_HTTPS_URL"
echo "Admin:     $SITE_HTTPS_URL/wp-admin"
echo "Username:  $WP_ADMIN_USER"
echo "Password:  $WP_ADMIN_PASSWORD"
echo "Database:  $DB_NAME"
echo "DB host:   ${DB_HOST}:${DB_PORT}"
echo "MU plugin: $LOCAL_MAIL_FILE"
